{
  "manifest_version": 3,
  "name": "TabNest",
  "version": "0.1.0",
  "description": "Organise tabs into spaces and collections. Share spaces as offline HTML files and sync them through Git (GitHub / Forgejo).",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "action": { "default_title": "Open TabNest" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["tabs", "storage", "unlimitedStorage", "alarms", "favicon"],
  "host_permissions": ["https://api.github.com/*", "https://raw.githubusercontent.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
